{
	"name": "awaitless",
	"version": "1.0.0",
	"description": "Chain property access and method calls on pending Promises, lazily, with types inferred from a schema.",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts --format esm,cjs --dts --tsconfig tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit && tsc -p tests/extension/tsconfig.json",
		"test": "vitest run --typecheck",
		"test:watch": "vitest --typecheck",
		"prepublishOnly": "npm run typecheck && npm test && npm run build",
		"prepare": "npm run build"
	},
	"keywords": [
		"promise",
		"async",
		"await",
		"chain",
		"chaining",
		"proxy",
		"lazy",
		"deferred",
		"thenable",
		"typescript",
		"type-inference"
	],
	"author": "den-asmos",
	"license": "ISC",
	"engines": {
		"node": ">=15"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	}
}
